# macOS
.DS_Store

# Xcode: the project is generated by XcodeGen from project.yml and never committed
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/

# Secrets: only *.example and *.template files are committed
.env
.env.*
!*.example
!*.template
*.local.xcconfig
*Secrets.xcconfig
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# Local search configuration: only Config/Local.xcconfig.example is committed
Config/Local.xcconfig
