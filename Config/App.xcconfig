// The app's build settings for search. Every value here is empty, so a plain clone
// builds an app whose search reports that it is not configured. Config/Local.xcconfig,
// which git ignores, sets the values on one machine; copy Config/Local.xcconfig.example
// to start it.

// The base URL of a search proxy that follows docs/search-api.md.
VERTEP_PROXY_BASE_URL =

// A personal TMDB API key, used where the proxy is not.
VERTEP_TMDB_API_KEY =

#include? "Local.xcconfig"
